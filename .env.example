# Admin inloggen (Nolie Schmink)
# Kopieer naar .env.local voor lokaal gebruik en voeg toe in Vercel → Settings → Environment Variables

ADMIN_USERNAME=Nolieschmink
ADMIN_PASSWORD=LekkerSchminken
SESSION_SECRET=vervang-dit-door-een-lange-willekeurige-tekst

